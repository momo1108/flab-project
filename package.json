{
  "name": "flab-project",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "private": true,
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --recursive --filter @flab/web... dev",
    "build": "pnpm --recursive --filter @flab/web... build:production",
    "build:staging": "pnpm --recursive --filter @flab/web... build:staging",
    "build:production": "pnpm --recursive --filter @flab/web... build:production",
    "preview": "pnpm --recursive --filter @flab/web... preview",
    "type-check": "pnpm --filter @flab/web type-check",
    "lint": "pnpm --filter @flab/web lint",
    "lint:fix": "pnpm --filter @flab/web lint:fix",
    "format": "pnpm --filter @flab/web format",
    "format:check": "pnpm --filter @flab/web format:check",
    "prepare": "husky install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "프론트엔드 개발 환경과 동작 방식을 공부하기 위한 레퍼지터리입니다.",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.8.0"
  },
  "devDependencies": {
    "@flab/eslint-config": "workspace:*",
    "husky": "^8.0.0",
    "lint-staged": "^16.4.0",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:"
  }
}
